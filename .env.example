# Development Environment Variables Template
# Copy this file to .env and fill in your actual values
# NEVER commit .env to Git - only .env.example should be in version control

# Flask Configuration
FLASK_ENV=development
FLASK_SECRET_KEY=your-super-secret-dev-key-change-in-production

# Google OAuth Configuration
# Path to your client_secrets.json file (downloaded from Google Cloud Console)
GOOGLE_OAUTH_SECRETS=client_secrets.json

# Server Port
PORT=5000

# Production Environment Variables (for deployment)
# Uncomment these when deploying to production:
# FLASK_ENV=production
# FLASK_SECRET_KEY=<generate with: python -c 'import secrets; print(secrets.token_hex(32))'>
